import React,{useState,useRef,useEffect} from 'react';
import {createRoot} from 'react-dom/client';
import SceneCanvas from '../components/SceneCanvas';
import {experimentBlank,mountains,temple,dog} from '../data/interaction-experiments';
import {makeForegroundRoom} from '../lib/scene-reframe';
import {measureCanvasContext} from '../components/canvas-context';
import {collectErasureTargets} from '../lib/eraser';
import Experiments from '../app/experiments/page';
import '../app/experiments/studio.css';
function Checks(){const[scene,setScene]=useState(experimentBlank),[reset,setReset]=useState(0),[phase,setPhase]=useState('ready'),[results,setResults]=useState([]);const root=useRef(null),state=useRef(null),drawing=useRef(false),current=useRef(scene),queue=useRef([]);current.current=scene;
 function begin(test){setScene(experimentBlank);setReset(n=>n+1);state.current=null;setTimeout(()=>{const old={...experimentBlank,objects:[mountains]};if(test.holes)old.erasures=[{id:'test-hole',paths:['M440 400L490 400'],width:20,targets:collectErasureTargets(old)}];setScene(old);state.current={...test,started:performance.now(),moved:false,frames:0,erasers:0,templePen:false,firstMatrix:null,lastMatrix:null};setPhase(test.name);},90);}
 useEffect(()=>{let frame;function sample(){const s=state.current,svg=root.current?.querySelector('svg');if(s&&svg){const age=performance.now()-s.started;if(!s.moved&&(s.active?age>450:age>500&&!drawing.current)){const g=measureCanvasContext(svg,current.current,'');const next=g&&makeForegroundRoom(current.current,g);if(!next){s.error='no transform';}else{const marks=JSON.stringify(current.current.objects[0].marks);s.sameMarks=marks===JSON.stringify(next.objects[0].marks);s.expectedBounds=measureCanvasContext(svg,current.current,'')?.objects[0].bounds;s.before=svg.querySelector('[data-manual-object]').getBoundingClientRect().width;s.motionStart=performance.now();s.moved=true;s.destination=next;setScene({...next,objects:[...next.objects,temple]});if(s.stream)setTimeout(()=>setScene(old=>({...old,objects:[...old.objects,dog]})),180);}}
 if(s.moved){s.erasers+=svg.querySelectorAll('[data-playback-artifact="eraser"],[data-playback-artifact="erasure"]').length;const moving=svg.querySelector('[data-pose-moving]');if(moving){s.frames++;const matrix=getComputedStyle(moving).transform;s.firstMatrix??=matrix;s.lastMatrix=matrix;const bounds=measureCanvasContext(svg,current.current,'')?.objects.find(o=>o.id===mountains.id)?.bounds;if(bounds){s.firstBounds??=bounds;s.lastBounds=bounds;}s.holesSeen ||= !!svg.querySelector('[data-permanent-erasure-mask]');}s.templePen ||= [...svg.querySelectorAll('[data-playback-artifact="pen"]')].some(p=>p.getAttribute('data-painter-subject')==='experiment-temple'&&p.getAttribute('display')!=='none');if(performance.now()-s.motionStart>900&&!drawing.current){s.after=svg.querySelector('[data-manual-object]').getBoundingClientRect().width;s.pass=s.sameMarks&&s.frames>=3&&s.firstMatrix!==s.lastMatrix&&s.erasers===0&&s.after<s.before&&s.templePen&&JSON.stringify(s.firstBounds)===JSON.stringify(s.lastBounds)&&(!s.holes||s.holesSeen);setResults(r=>[...r,s]);state.current=null;const next=queue.current.shift();if(next)begin(next);else setPhase('complete');}}
 if(age>35000){s.error='timeout';s.pass=false;setResults(r=>[...r,s]);state.current=null;setPhase('failed');}
 }frame=requestAnimationFrame(sample);}sample();return()=>cancelAnimationFrame(frame);},[]);
 function all(){setResults([]);queue.current=[{name:'Move completed pigment',active:false},{name:'Move during an unfinished contour',active:true},{name:'Retain holes and destination during new streamed art',active:true,holes:true,stream:true}];begin(queue.current.shift());}
 return <section><h1>Real engine · transform checks</h1><button onClick={all}>Run checks</button><p id="phase">{phase}</p><div ref={root} style={{width:1000,height:640}}><SceneCanvas scene={scene} style="crayon" playbackResetKey={reset} playbackTurn={1} motionMode="draw" onDrawingChange={v=>drawing.current=v}/></div><pre id="results">{JSON.stringify(results,null,2)}</pre></section>}
createRoot(document.getElementById('root')).render(location.pathname==='/checks.html'?<Checks/>:<Experiments/>);
